# Copy to .env.local and fill in the providers you want to check. Any provider without a key
# is shown as "not connected" and skipped. Never commit .env.local.

# Claude (also writes the brand profile, buyer questions and listing copy)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ChatGPT (OpenAI Responses API, with web search)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# Gemini (with Google Search grounding)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# DeepSeek (no web search in the API, so this measures what the model already knows)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Demo mode: answers are simulated for providers without a key, clearly labelled in the UI.
# For local UI work only. Never turn this on in production.
# SURFACED_DEMO=1

# Scans allowed per IP per hour (each scan makes many paid API calls).
# SCANS_PER_HOUR=6
# Stop automatic scans after this many seconds (keep under the host's function limit; Vercel Hobby is 300).
# SCAN_DEADLINE_SECONDS=270

# --- Spend and safety controls -------------------------------------------------------------------------------------
# Paid AI calls are OFF in production until accounts and spend limits exist. Leave this unset on the public deployment.
# AUTH_ENABLED=1
# Kill switch: refuse every automatic scan immediately (no redeploy of code needed, just this variable).
# SURFACED_PAUSE_SCANS=1
# Largest estimated cost (USD) one scan may have before it is refused.
# MAX_SCAN_USD=5
# Output and search caps per answer.
# CLAUDE_MAX_TOKENS=4000
# OPENAI_MAX_TOKENS=8000
# GEMINI_MAX_TOKENS=8000
# DEEPSEEK_MAX_TOKENS=4000
# MAX_SEARCHES=3
# Local UI work only: delay demo answers so the scan progress and Stop button can be seen.
# SURFACED_DEMO_DELAY_MS=800

# --- Site and security -----------------------------------------------------------------------------------------------
# Public address for canonical links, the sitemap and llms.txt. On Vercel the production URL is used if this is unset.
# NEXT_PUBLIC_SITE_URL=https://surfaced.example
# The content security policy is report-only until this is set (watch /api/csp-report logs for a week first).
# CSP_ENFORCE=1
# Only behind your own proxy that sets X-Forwarded-For. Not needed on Vercel.
# TRUST_PROXY=1

# --- Contact details shown on the legal pages ------------------------------------------------------------------------
# Shown as "not yet published" while unset. SECURITY_CONTACT also turns on /.well-known/security.txt.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@surfaced.example
# SECURITY_CONTACT=security@surfaced.example
# NEXT_PUBLIC_COMPANY_NAME=
