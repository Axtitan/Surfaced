{
  "name": "surfaced",
  "version": "0.1.0",
  "private": true,
  "description": "Checks whether Claude, ChatGPT, Gemini and DeepSeek recommend a product, then gets it listed where those AIs look.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "sync:destinations": "node scripts/sync-destinations.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ext:build": "node scripts/build-extension.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "8.5.30",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
